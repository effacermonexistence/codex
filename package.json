{
  "name": "omar-git-r2-backup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "doctor": "bash scripts/doctor.sh",
    "doctor:strict": "bash scripts/doctor.sh --strict",
    "os1:deploy": "bash scripts/deploy-os1.sh",
    "os1:publish": "bash scripts/publish-os1-release.sh",
    "os1:redteam": "pnpm --dir products/os1-route-core redteam:deployed",
    "types": "wrangler types",
    "check:scv-instagram": "node products/scv-instagram/scripts/verify-public-mirror.mjs",
    "check:scv-instagram:syntax": "find products/scv-instagram/runtime -type f -name '*.js' -not -path '*/node_modules/*' -exec node --check {} +",
    "check:scv-instagram:all": "pnpm run check:scv-instagram && pnpm run check:scv-instagram:syntax",
    "check:exo-monitor-r2": "bash scripts/test-os1-exo-monitor-r2.sh",
    "check:all": "pnpm run types && pnpm run check && pnpm run deploy:dry-run"
  },
  "dependencies": {
    "jose": "6.2.10"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "5.9.3",
    "wrangler": "4.127.1"
  },
  "packageManager": "pnpm@11.19.0"
}
