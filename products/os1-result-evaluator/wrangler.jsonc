{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "os1-result-evaluator",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    { "binding": "RCC_V26", "service": "os1-rcc-v26-private-v27" }
  ],
  "r2_buckets": [
    { "binding": "RESULTS", "bucket_name": "os1-private-results" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
