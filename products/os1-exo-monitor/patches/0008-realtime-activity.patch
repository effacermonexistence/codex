+++ b/scripts/test_activity_realtime.py
@@ -0,0 +1,134 @@
+"""Dependency-light tests of the exact packaged API source (no model loading)."""
+
+import ast
+import asyncio
+import json
+import math
+import time
+import unittest
+from dataclasses import dataclass
+from datetime import UTC, datetime, timedelta
+from pathlib import Path
+from types import SimpleNamespace
+from typing import cast
+
+SOURCE = Path(__file__).parents[1] / "src/exo/api/main.py"
+TREE = ast.parse(SOURCE.read_text())
+SCOPE = dict(
+    dataclass=dataclass,
+    datetime=datetime,
+    UTC=UTC,
+    json=json,
+    math=math,
+    cast=cast,
+    SystemPerformanceProfile=SimpleNamespace,
+)
+PARTS = [
+    node
+    for node in TREE.body
+    if isinstance(node, ast.ClassDef)
+    and node.name in {"_ActivitySensorSample", "_SensorTelemetry"}
+]
+exec(compile(ast.Module(body=PARTS, type_ignores=[]), str(SOURCE), "exec"), SCOPE)
+
+
+class SensorTests(unittest.TestCase):
+    def setUp(self):
+        self.sensor = SCOPE["_SensorTelemetry"]()
+        self.wall = datetime(2026, 9, 8, tzinfo=UTC)
+        self.profile = SimpleNamespace(
+            gpu_usage=0, pcpu_usage=0.1, ecpu_usage=0.2, sys_power=10, temp=40
+        )
+
+    def sample(self, offset=0):
+        wall = self.wall + timedelta(seconds=offset)
+        self.sensor.observe(
+            self.profile,
+            json.dumps({"timestamp": wall.isoformat()}),
+            100 + offset,
+            wall,
+        )
+
+    def test_unavailable_is_not_zero(self):
+        profile, status = self.sensor.snapshot(100)
+        self.assertIsNone(profile)
+        self.assertEqual(status["state"], "unavailable")
+
+    def test_measured_zero_and_stale(self):
+        self.sample()
+        profile, status = self.sensor.snapshot(101)
+        self.assertEqual(profile.gpu_usage, 0)
+        self.assertEqual(status["state"], "available")
+        self.assertIsNone(self.sensor.snapshot(116)[0])
+        self.assertEqual(self.sensor.snapshot(116)[1]["state"], "stale")
+
+    def test_energy_only_consecutive_sensor_samples(self):
+        self.sample()
+        self.sample(1)
+        self.assertEqual(self.sensor.joules, 10)
+        self.assertEqual(self.sensor.covered_seconds, 1)
+        self.sample(1)  # duplicate timestamp
+        self.sample(20)  # gap cannot accrue fabricated energy
+        self.assertEqual(self.sensor.joules, 10)
+        self.sample(21)
+        self.assertEqual(self.sensor.joules, 20)
+
+    def test_bad_values_fail_closed(self):
+        for field, value in [("gpu_usage", 1.1), ("temp", math.nan), ("sys_power", -1)]:
+            previous = getattr(self.profile, field)
+            setattr(self.profile, field, value)
+            self.sample()
+            self.assertEqual(self.sensor.snapshot(100)[1]["state"], "invalid")
+            setattr(self.profile, field, previous)
+
+    def test_old_future_and_naive_timestamps_fail_closed(self):
+        for raw in [
+            "bad",
+            "2026-09-08T00:00:00",
+            "2026-09-08T00:00:06Z",
+            "2026-09-07T23:59:44Z",
+        ]:
+            self.sensor.observe(
+                self.profile, json.dumps({"timestamp": raw}), 100, self.wall
+            )
+            self.assertEqual(self.sensor.snapshot(100)[1]["state"], "invalid")
+
+    def test_polling_snapshot_cannot_accrue_energy(self):
+        self.sample()
+        for now in range(100, 300):
+            self.sensor.snapshot(now)
+        self.assertEqual(self.sensor.joules, 0)
+
+
+class CacheTests(unittest.IsolatedAsyncioTestCase):
+    async def test_parallel_views_share_one_sample_and_counter_window(self):
+        api_class = next(
+            node
+            for node in TREE.body
+            if isinstance(node, ast.ClassDef) and node.name == "API"
+        )
+        method = next(
+            node
+            for node in api_class.body
+            if isinstance(node, ast.AsyncFunctionDef)
+            and node.name == "get_local_activity"
+        )
+        namespace = dict(time=time)
+        exec(
+            compile(ast.Module(body=[method], type_ignores=[]), str(SOURCE), "exec"),
+            namespace,
+        )
+        snapshot = {"sampled_at": "same real sample"}
+        api = SimpleNamespace(
+            _activity_lock=asyncio.Lock(),
+            _activity_previous_at=time.monotonic(),
+            _activity_cached_snapshot=snapshot,
+        )
+        results = await asyncio.gather(
+            *(namespace["get_local_activity"](api) for _ in range(20))
+        )
+        self.assertTrue(all(result is snapshot for result in results))
+
+
+if __name__ == "__main__":
+    unittest.main()
