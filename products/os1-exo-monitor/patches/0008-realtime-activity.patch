index 00000000..db4b1a4d
--- /dev/null
+++ b/dashboard/src/lib/utils/activityPolling.ts
@@ -0,0 +1,82 @@
+/** Independent, bounded polling: a slow peer must never hold local samples. */
+export function createActivityPoller(options: {
+  fetcher?: typeof fetch;
+  now?: () => number;
+  timeoutMs?: number;
+  onData: (key: string, data: unknown, latencyMs: number) => void;
+  onError: (key: string, error: string) => void;
+}) {
+  const fetcher = options.fetcher ?? fetch;
+  const now = options.now ?? Date.now;
+  const targets = new Map<string, { url: string; interval: number; due: number }>();
+  const active = new Map<string, AbortController>();
+  let paused = false;
+  let disposed = false;
+  function remove(key: string) {
+    targets.delete(key);
+    active.get(key)?.abort();
+    active.delete(key);
+  }
+  async function request(key: string, target: { url: string; interval: number; due: number }) {
+    const controller = new AbortController();
+    active.set(key, controller);
+    const started = now();
+    target.due = started + target.interval;
+    const timeout = setTimeout(() => controller.abort(), options.timeoutMs ?? 2500);
+    try {
+      const response = await fetcher(target.url, { signal: controller.signal, cache: "no-store" });
+      if (!response.ok) throw new Error(`HTTP ${response.status}`);
+      const data: unknown = await response.json();
+      if (!disposed && !paused && active.get(key) === controller && !controller.signal.aborted) {
+        options.onData(key, data, now() - started);
+      }
+    } catch (error) {
+      if (!disposed && !paused && active.get(key) === controller) {
+        options.onError(key, controller.signal.aborted ? "응답 시간 초과" : String(error));
+      }
+    } finally {
+      clearTimeout(timeout);
+      if (active.get(key) === controller) active.delete(key);
+    }
+  }
+  return {
+    set(key: string, url: string, interval: number) {
+      const previous = targets.get(key);
+      targets.set(key, { url, interval, due: previous?.due ?? 0 });
+    },
+    remove,
+    tick() {
+      if (paused || disposed) return;
+      for (const [key, target] of targets) {
+        if (!active.has(key) && now() >= target.due) void request(key, target);
+      }
+    },
+    pause(value: boolean) {
+      paused = value;
+      if (value) {
+        for (const controller of active.values()) controller.abort();
+        active.clear();
+      } else for (const target of targets.values()) target.due = 0;
+    },
+    dispose() {
+      disposed = true;
+      for (const key of targets.keys()) remove(key);
+    },
+  };
+}
+
+export function isFreshSample(value: unknown, now: number): value is { node_id: string; sampled_at: string } {
+  if (!value || typeof value !== "object") return false;
+  const data = value as Record<string, unknown>;
+  if (typeof data.node_id !== "string" || !data.node_id || typeof data.sampled_at !== "string") return false;
+  const timestamp = Date.parse(data.sampled_at);
+  return Number.isFinite(timestamp) && now - timestamp <= 15_000 && timestamp - now <= 5000;
+}
+
+export function privateActivityOrigin(ip: string): string | null {
+  const parts = ip.split(".");
+  if (parts.length !== 4 || parts.some((part) => !/^\d{1,3}$/.test(part) || Number(part) > 255)) return null;
+  const [first, second] = parts.map(Number);
+  return first === 10 || (first === 192 && second === 168) || (first === 172 && second >= 16 && second <= 31)
+    ? `http://${ip}:52415` : null;
+}
diff --git a/dashboard/src/lib/utils/activityTelemetry.ts b/dashboard/src/lib/utils/activityTelemetry.ts
new file mode 100644
index 00000000..d20127dc
--- /dev/null
+++ b/dashboard/src/lib/utils/activityTelemetry.ts
@@ -0,0 +1,196 @@
+export type SensorState = "available" | "unavailable" | "stale" | "invalid";
+
+export interface SensorActivity {
+  sampled_at: string;
+  sensor_status?: {
+    state: SensorState;
+    source: "exo_macmon";
+    sample_age_seconds: number | null;
+    sampled_at: string | null;
+  };
+  gpu: {
+    usage_percent: number | null;
+    temperature_celsius: number | null;
+    performance_cpu_percent: number | null;
+    efficiency_cpu_percent: number | null;
+  };
+  energy: {
+    system_power_watts: number | null;
+    monitor_session_joules: number | null;
+    monitor_session_watt_hours: number | null;
+    monitor_uptime_seconds: number;
+    sampled_duration_seconds?: number;
+  };
+}
+
+export function finiteMetric(
+  value: unknown,
+  minimum = 0,
+  maximum = Infinity,
+): number | null {
+  return typeof value === "number" &&
+    Number.isFinite(value) &&
+    value >= minimum &&
+    value <= maximum
+    ? value
+    : null;
+}
+
+export function sensorState(
+  activity: SensorActivity | null,
+  now: number,
+): SensorState {
+  const status = activity?.sensor_status;
+  // Legacy endpoints used zero for absent sensors. They provide no measurement evidence.
+  if (!status || status.source !== "exo_macmon") return "unavailable";
+  if (status.state !== "available") {
+    return ["unavailable", "stale", "invalid"].includes(status.state)
+      ? status.state
+      : "invalid";
+  }
+  const age = finiteMetric(status.sample_age_seconds);
+  const measuredAt = status.sampled_at ? Date.parse(status.sampled_at) : NaN;
+  const responseAt = Date.parse(activity!.sampled_at);
+  if (
+    age === null ||
+    !Number.isFinite(measuredAt) ||
+    !Number.isFinite(responseAt) ||
+    measuredAt > now + 5000 ||
+    responseAt > now + 5000
+  )
+    return "invalid";
+  // The cached response ages while a peer is unreachable; polling is not a new sensor sample.
+  if (
+    Math.max(
+      age + Math.max(0, now - responseAt) / 1000,
+      (now - measuredAt) / 1000,
+    ) > 15
+  )
+    return "stale";
+  return "available";
+}
+
+export function sensorValues(activity: SensorActivity | null, now: number) {
+  let state = sensorState(activity, now);
+  if (
+    state === "available" &&
+    (finiteMetric(activity?.gpu.usage_percent, 0, 100) === null ||
+      finiteMetric(activity?.gpu.temperature_celsius, 0, 150) === null ||
+      finiteMetric(activity?.gpu.performance_cpu_percent, 0, 100) === null ||
+      finiteMetric(activity?.gpu.efficiency_cpu_percent, 0, 100) === null ||
+      finiteMetric(activity?.energy.system_power_watts, 0, 10000) === null)
+  )
+    state = "invalid";
+  const valid = state === "available";
+  return {
+    state,
+    gpu: valid ? finiteMetric(activity?.gpu.usage_percent, 0, 100) : null,
+    temperature: valid
+      ? finiteMetric(activity?.gpu.temperature_celsius, 0, 150)
+      : null,
+    performanceCpu: valid
+      ? finiteMetric(activity?.gpu.performance_cpu_percent, 0, 100)
+      : null,
+    efficiencyCpu: valid
+      ? finiteMetric(activity?.gpu.efficiency_cpu_percent, 0, 100)
+      : null,
+    power: valid
+      ? finiteMetric(activity?.energy.system_power_watts, 0, 10000)
+      : null,
+    wattHours: valid
+      ? finiteMetric(activity?.energy.monitor_session_watt_hours)
+      : null,
+    sampledSeconds: valid
+      ? finiteMetric(activity?.energy.sampled_duration_seconds)
+      : null,
+  };
+}
+
+export function completeSum(values: Array<number | null>): number | null {
+  if (!values.length || values.some((value) => finiteMetric(value) === null))
+    return null;
+  return (values as number[]).reduce((sum, value) => sum + value, 0);
+}
+
+export function formatMetric(
+  value: number | null | undefined,
+  decimals = 0,
+  suffix = "",
+): string {
+  return finiteMetric(value) === null
+    ? "Unavailable"
+    : `${value!.toFixed(decimals)}${suffix}`;
+}
+
+export function sparklinePath(
+  values: Array<number | null>,
+  floor = 100,
+): string {
+  const valid = values.map((value) => finiteMetric(value));
+  if (values.length < 2) return "";
+  const maximum = Math.max(
+    floor,
+    ...valid.filter((value): value is number => value !== null),
+  );
+  let connected = false;
+  return valid
+    .map((value, index) => {
+      if (value === null) {
+        connected = false;
+        return "";
+      }
+      const x = (index / (values.length - 1)) * 100;
+      const y = 28 - (value / maximum) * 26;
+      const command = `${connected ? "L" : "M"}${x.toFixed(1)},${y.toFixed(1)}`;
+      connected = true;
+      return command;
+    })
+    .filter(Boolean)
+    .join(" ");
+}
+
+export function balanceScore(
+  rows: Array<{
+    stale: boolean;
+    sensorState: SensorState;
+    cpu: number | null;
+    memoryPercent: number | null;
+    gpu: number | null;
+    power: number | null;
+    queue: number | null;
+  }>,
+) {
+  if (rows.length !== 2 || rows.some((row) => row.stale))
+    return { score: null, spread: null, status: "WAITING FOR 2 FRESH NODES" };
+  if (
+    rows.some(
+      (row) =>
+        row.sensorState !== "available" ||
+        finiteMetric(row.gpu, 0, 100) === null ||
+        finiteMetric(row.power, 0, 10000) === null,
+    )
+  )
+    return { score: null, spread: null, status: "SENSOR DATA UNAVAILABLE" };
+  if (
+    rows.some(
+      (row) =>
+        finiteMetric(row.cpu, 0, 100) === null ||
+        finiteMetric(row.memoryPercent, 0, 100) === null ||
+        finiteMetric(row.queue) === null,
+    )
+  )
+    return { score: null, spread: null, status: "LOAD DATA UNAVAILABLE" };
+  const loads = rows.map(
+    (row) =>
+      0.35 * row.cpu! +
+      0.35 * row.memoryPercent! +
+      0.2 * row.gpu! +
+      10 * Math.min(row.queue! / 4, 1),
+  );
+  const spread = Math.max(...loads) - Math.min(...loads);
+  return {
+    score: 100 - spread,
+    spread,
+    status: spread <= 15 ? "CONVERGED" : "OBSERVED LOAD IMBALANCE",
+  };
+}
diff --git a/dashboard/tests/activity-polling.test.mjs b/dashboard/tests/activity-polling.test.mjs
new file mode 100644
index 00000000..a6326cd1
--- /dev/null
+++ b/dashboard/tests/activity-polling.test.mjs
@@ -0,0 +1,79 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { createActivityPoller, isFreshSample, privateActivityOrigin } from "../src/lib/utils/activityPolling.ts";
+const flush = () => new Promise((resolve) => setImmediate(resolve));
+
+test("only valid paired private IPv4 origins are eligible", () => {
+  for (const ip of ["10.215.90.216", "10.215.90.72", "192.168.1.3", "172.16.1.2"]) assert.equal(privateActivityOrigin(ip), `http://${ip}:52415`);
+  for (const ip of ["example.com", "8.8.8.8", "172.15.1.2", "10.0.0.999", "10.0.0.1/path"]) assert.equal(privateActivityOrigin(ip), null);
+});
+
+test("slow peers and failed topology never hold a local response; no overlaps", async () => {
+  const received = [], errors = [], requests = [];
+  let now = 1000;
+  const poller = createActivityPoller({
+    now: () => now,
+    fetcher: async (url, { signal }) => {
+      requests.push(url);
+      if (url === "/state") throw Error("offline");
+      if (url === "/air") return new Promise((resolve, reject) => signal.addEventListener("abort", () => reject(Error("aborted"))));
+      return { ok: true, json: async () => ({ at: now }) };
+    },
+    onData: (key, data) => received.push([key, data.at]),
+    onError: (key) => errors.push(key),
+  });
+  poller.set("state", "/state", 5000);
+  poller.set("air", "/air", 1000);
+  poller.set("local", "/local", 1000);
+  poller.tick(); await flush();
+  assert.deepEqual(received, [["local", 1000]]);
+  assert.deepEqual(errors, ["state"]);
+  now += 1000; poller.tick(); await flush();
+  assert.deepEqual(received, [["local", 1000], ["local", 2000]]);
+  assert.equal(requests.filter((url) => url === "/air").length, 1);
+  poller.dispose(); await flush();
+  assert.deepEqual(errors, ["state"]);
+});
+
+test("pause, target removal and disposal abort requests and suppress late callbacks", async () => {
+  let resolveResponse, count = 0, signal;
+  const received = [];
+  const poller = createActivityPoller({
+    fetcher: async (_url, options) => {
+      count++; signal = options.signal;
+      return new Promise((resolve) => { resolveResponse = resolve; });
+    },
+    onData: (key) => received.push(key), onError: () => assert.fail("cancel callback"),
+  });
+  poller.set("local", "/local", 1000); poller.tick();
+  poller.pause(true); assert.equal(signal.aborted, true);
+  resolveResponse({ ok: true, json: async () => ({}) }); await flush();
+  poller.tick(); assert.equal(count, 1); assert.deepEqual(received, []);
+  poller.pause(false); poller.tick(); assert.equal(count, 2);
+  poller.remove("local"); assert.equal(signal.aborted, true);
+  resolveResponse({ ok: true, json: async () => ({}) }); await flush();
+  assert.deepEqual(received, []); poller.dispose();
+});
+
+test("timeouts are visible and recover on the next independent tick", async () => {
+  const errors = [], received = [];
+  let blocked = true;
+  const poller = createActivityPoller({ timeoutMs: 10,
+    fetcher: async (_url, { signal }) => blocked
+      ? new Promise((_resolve, reject) => signal.addEventListener("abort", () => reject(Error("timeout"))))
+      : { ok: true, json: async () => ({}) },
+    onData: (key) => received.push(key), onError: (key) => errors.push(key),
+  });
+  poller.set("local", "/local", 0); poller.tick();
+  await new Promise((resolve) => setTimeout(resolve, 30));
+  assert.deepEqual(errors, ["local"]);
+  blocked = false; poller.tick(); await flush();
+  assert.deepEqual(received, ["local"]); poller.dispose();
+});
+
+test("old, malformed and future packets cannot advance freshness", () => {
+  const now = Date.now();
+  for (const offset of [-16000, 6000]) assert.equal(isFreshSample({ node_id: "pro", sampled_at: new Date(now + offset).toISOString() }, now), false);
+  for (const value of [null, {}, { node_id: "pro", sampled_at: "bad" }]) assert.equal(isFreshSample(value, now), false);
+  assert.equal(isFreshSample({ node_id: "pro", sampled_at: new Date(now).toISOString() }, now), true);
+});
diff --git a/dashboard/tests/activity-telemetry.test.mjs b/dashboard/tests/activity-telemetry.test.mjs
new file mode 100644
index 00000000..ba96dae6
--- /dev/null
+++ b/dashboard/tests/activity-telemetry.test.mjs
@@ -0,0 +1,138 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  balanceScore,
+  completeSum,
+  finiteMetric,
+  formatMetric,
+  sensorState,
+  sensorValues,
+  sparklinePath,
+} from "../src/lib/utils/activityTelemetry.ts";
+
+const now = Date.parse("2026-09-08T00:00:10Z");
+const sample = () => ({
+  sampled_at: new Date(now).toISOString(),
+  sensor_status: {
+    state: "available",
+    source: "exo_macmon",
+    sample_age_seconds: 1,
+    sampled_at: new Date(now - 1000).toISOString(),
+  },
+  gpu: {
+    usage_percent: 0,
+    temperature_celsius: 38,
+    performance_cpu_percent: 0,
+    efficiency_cpu_percent: 12,
+  },
+  energy: {
+    system_power_watts: 0,
+    monitor_session_joules: 0,
+    monitor_session_watt_hours: 0,
+    monitor_uptime_seconds: 40,
+    sampled_duration_seconds: 3,
+  },
+});
+
+test("legacy Pro zero defaults are unavailable without sensor provenance", () => {
+  const legacy = sample();
+  delete legacy.sensor_status;
+  const values = sensorValues(legacy, now);
+  assert.equal(values.state, "unavailable");
+  for (const field of [
+    "gpu",
+    "temperature",
+    "power",
+    "wattHours",
+    "sampledSeconds",
+  ])
+    assert.equal(values[field], null);
+  assert.equal(formatMetric(values.gpu, 0, "%"), "Unavailable");
+});
+
+test("real measured zero remains zero and coverage is not process uptime", () => {
+  const values = sensorValues(sample(), now);
+  assert.equal(values.state, "available");
+  assert.equal(formatMetric(values.gpu, 0, "%"), "0%");
+  assert.equal(formatMetric(values.power, 1, " W"), "0.0 W");
+  assert.equal(values.sampledSeconds, 3);
+});
+
+test("cached packets age independently of successful endpoint polling", () => {
+  assert.equal(sensorState(sample(), now + 14000), "available");
+  assert.equal(sensorState(sample(), now + 15001), "stale");
+  assert.equal(sensorValues(sample(), now + 15001).gpu, null);
+});
+
+test("invalid metadata, future timestamps, NaN, infinities and out of range values fail closed", () => {
+  for (const value of [NaN, Infinity, -1, "0", null, undefined])
+    assert.equal(finiteMetric(value), null);
+  for (const state of ["unavailable", "stale", "invalid"]) {
+    const activity = sample();
+    activity.sensor_status.state = state;
+    assert.equal(sensorValues(activity, now).power, null);
+  }
+  const invalid = sample();
+  invalid.sensor_status.sample_age_seconds = NaN;
+  assert.equal(sensorState(invalid, now), "invalid");
+  const future = sample();
+  future.sensor_status.sampled_at = new Date(now + 6000).toISOString();
+  assert.equal(sensorState(future, now), "invalid");
+  const bounds = sample();
+  bounds.gpu.usage_percent = 101;
+  bounds.energy.system_power_watts = -10;
+  assert.equal(sensorValues(bounds, now).gpu, null);
+  assert.equal(sensorValues(bounds, now).power, null);
+});
+
+test("missing energy coverage and first sensor interval are never formatted as zero", () => {
+  const first = sample();
+  first.energy.monitor_session_watt_hours = null;
+  delete first.energy.sampled_duration_seconds;
+  const values = sensorValues(first, now);
+  assert.equal(formatMetric(values.wattHours, 3, " Wh"), "Unavailable");
+  assert.equal(values.sampledSeconds, null);
+});
+
+test("cluster totals require every node and retain measured zero", () => {
+  assert.equal(completeSum([0, 0]), 0);
+  assert.equal(completeSum([15, null]), null);
+  assert.equal(completeSum([]), null);
+});
+
+test("graphs split missing intervals instead of inventing zeros or bridging gaps", () => {
+  assert.equal(
+    sparklinePath([10, null, 20, 30]),
+    "M0.0,25.4 M66.7,22.8 L100.0,20.2",
+  );
+  assert.equal(sparklinePath([null, null]), "");
+  assert.equal(sparklinePath([NaN, Infinity]), "");
+  assert.equal(sparklinePath([0, 0]), "M0.0,28.0 L100.0,28.0");
+});
+
+test("balance requires exactly two fresh measured nodes and fresh queue data", () => {
+  const row = {
+    stale: false,
+    sensorState: "available",
+    cpu: 10,
+    memoryPercent: 20,
+    gpu: 0,
+    power: 0,
+    queue: 0,
+  };
+  assert.equal(balanceScore([row, row]).score, 100);
+  for (const change of [
+    { stale: true },
+    { sensorState: "unavailable" },
+    { sensorState: "stale" },
+    { gpu: null },
+    { power: null },
+    { queue: null },
+    { cpu: NaN },
+    { gpu: 101 },
+  ]) {
+    assert.equal(balanceScore([row, { ...row, ...change }]).score, null);
+  }
+  assert.equal(balanceScore([row]).score, null);
+  assert.equal(balanceScore([row, row, row]).score, null);
+});
diff --git a/dashboard/tests/activity-dashboard-browser.test.mjs b/dashboard/tests/activity-dashboard-browser.test.mjs
new file mode 100644
index 00000000..4dfa3d47
--- /dev/null
+++ b/dashboard/tests/activity-dashboard-browser.test.mjs
@@ -0,0 +1,216 @@
+// Run against a built dashboard with OS1_TEST_PLAYWRIGHT_MODULE pointing at an
+// existing Playwright installation. The browser gets synthetic read-only data;
+// it cannot reach either production EXO endpoint.
+import assert from "node:assert/strict";
+import { createServer } from "node:http";
+import { readFile } from "node:fs/promises";
+import { resolve, sep } from "node:path";
+import { createRequire } from "node:module";
+
+const require = createRequire(import.meta.url);
+const { chromium } = require(
+  process.env.OS1_TEST_PLAYWRIGHT_MODULE || "playwright",
+);
+const root = resolve("build");
+const server = createServer(async (request, response) => {
+  const target = resolve(
+    root,
+    `.${new URL(request.url, "http://localhost").pathname}`,
+  );
+  if (target !== root && !target.startsWith(root + sep)) {
+    response.writeHead(403).end();
+    return;
+  }
+  const file = target === root ? resolve(root, "index.html") : target;
+  const extension = file.split(".").pop();
+  const types = {
+    html: "text/html",
+    js: "application/javascript",
+    css: "text/css",
+    json: "application/json",
+    png: "image/png",
+    svg: "image/svg+xml",
+    woff2: "font/woff2",
+  };
+  try {
+    response
+      .writeHead(200, {
+        "content-type": types[extension] || "application/octet-stream",
+      })
+      .end(await readFile(file));
+  } catch {
+    response.writeHead(404).end();
+  }
+});
+await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
+const origin = `http://127.0.0.1:${server.address().port}`;
+const fleet = ["air", "pro"].map((role) => ({
+  role,
+  device_id: role,
+  zerotier_ip: role === "air" ? "10.215.90.216" : "10.215.90.72",
+  last_seen_ms: Date.now(),
+  queue_depth: 0,
+  has_codex: true,
+  has_claude: true,
+}));
+const fixture = (role, available) => ({
+  node_id: role,
+  sampled_at: new Date().toISOString(),
+  sample_interval_seconds: 1,
+  host: {
+    role,
+    device_id: role,
+    zerotier_ip: fleet.find((node) => node.role === role).zerotier_ip,
+  },
+  cpu: {
+    system_percent: 10,
+    per_core_percent: [10],
+    logical_count: 10,
+    load_average_1m: 1,
+    exo_process_percent: 0,
+  },
+  memory: {
+    total_bytes: 16000000000,
+    used_bytes: 8000000000,
+    available_bytes: 8000000000,
+    swap_total_bytes: 0,
+    swap_used_bytes: 0,
+    exo_process_resident_bytes: 1,
+  },
+  gpu: {
+    usage_percent: 0,
+    temperature_celsius: available ? 40 : 0,
+    performance_cpu_percent: 0,
+    efficiency_cpu_percent: 0,
+  },
+  energy: {
+    system_power_watts: 0,
+    monitor_session_joules: 0,
+    monitor_session_watt_hours: 0,
+    monitor_uptime_seconds: 60,
+    sampled_duration_seconds: 2,
+  },
+  ...(available
+    ? {
+        sensor_status: {
+          state: "available",
+          source: "exo_macmon",
+          sample_age_seconds: 0,
+          sampled_at: new Date().toISOString(),
+        },
+      }
+    : {}),
+  disk: { read_bytes_per_second: 0, write_bytes_per_second: 0 },
+  network: { received_bytes_per_second: 0, sent_bytes_per_second: 0 },
+  exo: { topology_nodes: 2, instances: 0, runners: 0, tasks: 0 },
+  fleet: { nodes: fleet, recent_jobs: [] },
+});
+const state = {
+  topology: { nodes: ["air", "pro"] },
+  nodeIdentities: {
+    air: { friendlyName: "MacBook Air" },
+    pro: { friendlyName: "MacBook Pro" },
+  },
+  nodeSystem: {},
+  nodeNetwork: Object.fromEntries(
+    fleet.map((node) => [
+      node.role,
+      { interfaces: [{ name: "test", ipAddress: node.zerotier_ip }] },
+    ]),
+  ),
+};
+const browser = await chromium.launch({ headless: true, channel: process.env.OS1_TEST_BROWSER_CHANNEL || undefined });
+try {
+  for (const available of [false, true]) {
+    const page = await browser.newPage({
+      viewport: { width: 1440, height: 1100 },
+    });
+    const failures = [];
+    let localSamples = 0, peerSamples = 0, topologyOffline = false, peerOffline = false;
+    page.on("pageerror", (error) => failures.push(error.message));
+    await page.route("**/*", async (route) => {
+      const url = new URL(route.request().url());
+      assert.equal(
+        route.request().method(),
+        "GET",
+        "dashboard must remain read-only",
+      );
+      if (url.pathname === "/state") return route.fulfill(topologyOffline ? { status: 503, body: "offline fixture" } : { json: state });
+      if (url.pathname === "/activity/local") {
+        const peer = url.hostname === "10.215.90.72";
+        if (peer) { peerSamples++; if (peerOffline) return route.abort(); }
+        else localSamples++;
+        return route.fulfill({
+          json: fixture(
+            url.hostname === "10.215.90.72" ? "pro" : "air",
+            url.hostname === "10.215.90.72" ? available : true,
+          ),
+          headers: { "access-control-allow-origin": "*" },
+        });
+      }
+      if (url.origin !== origin) return route.abort();
+      return route.continue();
+    });
+    await page.goto(`${origin}/#/activity`);
+    await page
+      .getByRole("heading", { name: "MacBook Pro", exact: true })
+      .waitFor();
+    const pro = page
+      .locator("article")
+      .filter({
+        has: page.getByRole("heading", { name: "MacBook Pro", exact: true }),
+      });
+    if (!available) {
+      await page
+        .getByText("SENSOR DATA UNAVAILABLE", { exact: true })
+        .waitFor();
+      assert.match(await pro.innerText(), /Sensor unavailable/);
+      assert.match(await pro.innerText(), /Unavailable/);
+      assert.doesNotMatch(await pro.innerText(), /0\.0 W|0°C|0\.000 Wh/);
+      assert.ok(
+        (await page.locator("main").innerText()).includes(
+          "GPU AVG\nUnavailable",
+        ),
+      );
+    } else {
+      await page.getByText("CONVERGED", { exact: true }).waitFor();
+      assert.match(await pro.innerText(), /0\.0 W/);
+      assert.match(await pro.innerText(), /valid sample coverage 2\.0 s/);
+      const liveCount = localSamples;
+      await page.getByRole("button", { name: "일시정지", exact: true }).click();
+      await page.waitForTimeout(1600);
+      assert.equal(localSamples, liveCount, "pause must stop polling, not just repainting");
+      assert.match(await pro.innerText(), /PAUSED/);
+      await page.getByRole("button", { name: "실시간 재개", exact: true }).click();
+      topologyOffline = true;
+      peerOffline = true;
+      const independentStart = localSamples;
+      await page.waitForTimeout(16500);
+      process.stdout.write(JSON.stringify({ test: "independent refresh", localSamples: localSamples - independentStart, peerSamples }) + "\n");
+      assert.ok(localSamples >= independentStart + 12, `local samples continue through topology + peer failures: ${localSamples - independentStart} samples`);
+      assert.match(await pro.innerText(), /STALE/);
+      assert.match(await pro.innerText(), /Read Unavailable/);
+      assert.match(await page.locator("article").filter({ has: page.getByRole("heading", { name: "MacBook Air", exact: true }) }).innerText(), /LIVE/);
+      assert.ok(peerSamples > 2);
+      peerOffline = false; topologyOffline = false;
+      await page.waitForTimeout(1500);
+      assert.match(await pro.innerText(), /LIVE/);
+      await page.getByLabel("갱신 주기", { exact: true }).selectOption("5");
+      assert.match(await page.locator("main").innerText(), /독립적으로 5초마다/);
+      await page.getByLabel("갱신 주기", { exact: true }).selectOption("1");
+    }
+    assert.deepEqual(failures, []);
+    if (process.env.OS1_TEST_SCREENSHOT_DIR)
+      await page.screenshot({
+        path: `${process.env.OS1_TEST_SCREENSHOT_DIR}/${available ? "measured-zero" : "legacy-unavailable"}.png`,
+        fullPage: true,
+      });
+    await page.close();
+  }
+  process.stdout.write(
+    "PASS: built dashboard legacy-unavailable + measured-zero browser checks; no JS errors; GET-only\n",
+  );
+} finally {
+  await browser.close();
+  await new Promise((resolve) => server.close(resolve));
