+@dataclass
+class _ActivitySensorSample:
+    profile: SystemPerformanceProfile
+    timestamp: datetime
+    observed_at: float
+    initial_age: float
+
+
+class _SensorTelemetry:
+    """Observe the existing EXO sampler, never synthesize missing measurements."""
+
+    def __init__(self) -> None:
+        self.sample: _ActivitySensorSample | None = None
+        self.invalid = False
+        self.joules = 0.0
+        self.covered_seconds = 0.0
+
+    def observe(
+        self,
+        profile: SystemPerformanceProfile,
+        raw: str,
+        now: float,
+        wall_now: datetime,
+    ) -> None:
+        try:
+            payload = cast(dict[str, object], json.loads(raw))
+            raw_timestamp = payload.get("timestamp")
+            if not isinstance(raw_timestamp, str):
+                raise TypeError("missing sensor timestamp")
+            timestamp = datetime.fromisoformat(raw_timestamp)
+            if timestamp.tzinfo is None:
+                raise ValueError("timezone required")
+            values = (
+                profile.gpu_usage,
+                profile.pcpu_usage,
+                profile.ecpu_usage,
+                profile.sys_power,
+                profile.temp,
+            )
+            if not all(math.isfinite(value) for value in values):
+                raise ValueError("nonfinite sensor value")
+            if (
+                not all(0 <= value <= 1 for value in values[:3])
+                or profile.sys_power < 0
+                or not 0 <= profile.temp <= 150
+            ):
+                raise ValueError("sensor value outside range")
+            age = (wall_now - timestamp).total_seconds()
+            if age < -5 or age > 15:
+                raise ValueError("sensor timestamp not current")
+        except (AttributeError, TypeError, ValueError):
+            self.invalid = True
+            self.sample = None
+            return
+        previous = self.sample
+        if previous is not None:
+            elapsed = (timestamp - previous.timestamp).total_seconds()
+            if 0 < elapsed <= 5:
+                self.joules += (
+                    (previous.profile.sys_power + profile.sys_power) * 0.5 * elapsed
+                )
+                self.covered_seconds += elapsed
+        self.sample = _ActivitySensorSample(profile, timestamp, now, max(age, 0))
+        self.invalid = False
+
+    def snapshot(
+        self, now: float
+    ) -> tuple[SystemPerformanceProfile | None, dict[str, object]]:
+        sample = self.sample
+        age = None if sample is None else sample.initial_age + now - sample.observed_at
+        state = (
+            "invalid"
+            if self.invalid
+            else "unavailable"
+            if age is None
+            else "available"
+            if 0 <= age <= 15
+            else "stale"
+        )
+        return (
+            sample.profile if sample is not None and state == "available" else None
+        ), {
+            "state": state,
+            "source": "exo_macmon",
+            "sample_age_seconds": age,
+            "sampled_at": sample.timestamp.isoformat() if sample else None,
+        }
