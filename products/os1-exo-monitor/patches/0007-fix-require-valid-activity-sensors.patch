diff --git a/dashboard/tests/activity-dashboard-browser.test.mjs b/dashboard/tests/activity-dashboard-browser.test.mjs
new file mode 100644
index 00000000..7fc6a15e
--- /dev/null
+++ b/dashboard/tests/activity-dashboard-browser.test.mjs
@@ -0,0 +1,189 @@
+// Run against a built dashboard with OS1_TEST_PLAYWRIGHT_MODULE pointing at an
+// existing Playwright installation. The browser gets synthetic read-only data;
+// it cannot reach either production EXO endpoint.
+import assert from "node:assert/strict";
+import { createServer } from "node:http";
+import { readFile } from "node:fs/promises";
+import { resolve, sep } from "node:path";
+import { createRequire } from "node:module";
+
+const require = createRequire(import.meta.url);
+const { chromium } = require(
+  process.env.OS1_TEST_PLAYWRIGHT_MODULE || "playwright",
+);
+const root = resolve("build");
+const server = createServer(async (request, response) => {
+  const target = resolve(
+    root,
+    `.${new URL(request.url, "http://localhost").pathname}`,
+  );
+  if (target !== root && !target.startsWith(root + sep)) {
+    response.writeHead(403).end();
+    return;
+  }
+  const file = target === root ? resolve(root, "index.html") : target;
+  const extension = file.split(".").pop();
+  const types = {
+    html: "text/html",
+    js: "application/javascript",
+    css: "text/css",
+    json: "application/json",
+    png: "image/png",
+    svg: "image/svg+xml",
+    woff2: "font/woff2",
+  };
+  try {
+    response
+      .writeHead(200, {
+        "content-type": types[extension] || "application/octet-stream",
+      })
+      .end(await readFile(file));
+  } catch {
+    response.writeHead(404).end();
+  }
+});
+await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
+const origin = `http://127.0.0.1:${server.address().port}`;
+const fleet = ["air", "pro"].map((role) => ({
+  role,
+  device_id: role,
+  zerotier_ip: role === "air" ? "10.215.90.216" : "10.215.90.72",
+  last_seen_ms: Date.now(),
+  queue_depth: 0,
+  has_codex: true,
+  has_claude: true,
+}));
+const fixture = (role, available) => ({
+  node_id: role,
+  sampled_at: new Date().toISOString(),
+  sample_interval_seconds: 1,
+  host: {
+    role,
+    device_id: role,
+    zerotier_ip: fleet.find((node) => node.role === role).zerotier_ip,
+  },
+  cpu: {
+    system_percent: 10,
+    per_core_percent: [10],
+    logical_count: 10,
+    load_average_1m: 1,
+    exo_process_percent: 0,
+  },
+  memory: {
+    total_bytes: 16000000000,
+    used_bytes: 8000000000,
+    available_bytes: 8000000000,
+    swap_total_bytes: 0,
+    swap_used_bytes: 0,
+    exo_process_resident_bytes: 1,
+  },
+  gpu: {
+    usage_percent: 0,
+    temperature_celsius: available ? 40 : 0,
+    performance_cpu_percent: 0,
+    efficiency_cpu_percent: 0,
+  },
+  energy: {
+    system_power_watts: 0,
+    monitor_session_joules: 0,
+    monitor_session_watt_hours: 0,
+    monitor_uptime_seconds: 60,
+    sampled_duration_seconds: 2,
+  },
+  ...(available
+    ? {
+        sensor_status: {
+          state: "available",
+          source: "exo_macmon",
+          sample_age_seconds: 0,
+          sampled_at: new Date().toISOString(),
+        },
+      }
+    : {}),
+  disk: { read_bytes_per_second: 0, write_bytes_per_second: 0 },
+  network: { received_bytes_per_second: 0, sent_bytes_per_second: 0 },
+  exo: { topology_nodes: 2, instances: 0, runners: 0, tasks: 0 },
+  fleet: { nodes: fleet, recent_jobs: [] },
+});
+const state = {
+  topology: { nodes: ["air", "pro"] },
+  nodeIdentities: {
+    air: { friendlyName: "MacBook Air" },
+    pro: { friendlyName: "MacBook Pro" },
+  },
+  nodeSystem: {},
+  nodeNetwork: Object.fromEntries(
+    fleet.map((node) => [
+      node.role,
+      { interfaces: [{ name: "test", ipAddress: node.zerotier_ip }] },
+    ]),
+  ),
+};
+const browser = await chromium.launch({ headless: true });
+try {
+  for (const available of [false, true]) {
+    const page = await browser.newPage({
+      viewport: { width: 1440, height: 1100 },
+    });
+    const failures = [];
+    page.on("pageerror", (error) => failures.push(error.message));
+    await page.route("**/*", async (route) => {
+      const url = new URL(route.request().url());
+      assert.equal(
+        route.request().method(),
+        "GET",
+        "dashboard must remain read-only",
+      );
+      if (url.pathname === "/state") return route.fulfill({ json: state });
+      if (url.pathname === "/activity/local")
+        return route.fulfill({
+          json: fixture(
+            url.hostname === "10.215.90.72" ? "pro" : "air",
+            url.hostname === "10.215.90.72" ? available : true,
+          ),
+          headers: { "access-control-allow-origin": "*" },
+        });
+      if (url.origin !== origin) return route.abort();
+      return route.continue();
+    });
+    await page.goto(`${origin}/#/activity`);
+    await page
+      .getByRole("heading", { name: "MacBook Pro", exact: true })
+      .waitFor();
+    const pro = page
+      .locator("article")
+      .filter({
+        has: page.getByRole("heading", { name: "MacBook Pro", exact: true }),
+      });
+    if (!available) {
+      await page
+        .getByText("SENSOR DATA UNAVAILABLE", { exact: true })
+        .waitFor();
+      assert.match(await pro.innerText(), /Sensor unavailable/);
+      assert.match(await pro.innerText(), /Unavailable/);
+      assert.doesNotMatch(await pro.innerText(), /0\.0 W|0°C|0\.000 Wh/);
+      assert.ok(
+        (await page.locator("main").innerText()).includes(
+          "GPU AVG\nUnavailable",
+        ),
+      );
+    } else {
+      await page.getByText("CONVERGED", { exact: true }).waitFor();
+      assert.match(await pro.innerText(), /0\.0 W/);
+      assert.match(await pro.innerText(), /valid sample coverage 2\.0 s/);
+    }
+    assert.deepEqual(failures, []);
+    if (process.env.OS1_TEST_SCREENSHOT_DIR)
+      await page.screenshot({
+        path: `${process.env.OS1_TEST_SCREENSHOT_DIR}/${available ? "measured-zero" : "legacy-unavailable"}.png`,
+        fullPage: true,
+      });
+    await page.close();
+  }
+  process.stdout.write(
+    "PASS: built dashboard legacy-unavailable + measured-zero browser checks; no JS errors; GET-only\n",
+  );
+} finally {
+  await browser.close();
+  await new Promise((resolve) => server.close(resolve));
+}
diff --git a/dashboard/tests/activity-telemetry.test.mjs b/dashboard/tests/activity-telemetry.test.mjs
new file mode 100644
index 00000000..ba96dae6
--- /dev/null
+++ b/dashboard/tests/activity-telemetry.test.mjs
@@ -0,0 +1,138 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  balanceScore,
+  completeSum,
+  finiteMetric,
+  formatMetric,
+  sensorState,
+  sensorValues,
+  sparklinePath,
+} from "../src/lib/utils/activityTelemetry.ts";
+
+const now = Date.parse("2026-09-08T00:00:10Z");
+const sample = () => ({
+  sampled_at: new Date(now).toISOString(),
+  sensor_status: {
+    state: "available",
+    source: "exo_macmon",
+    sample_age_seconds: 1,
+    sampled_at: new Date(now - 1000).toISOString(),
+  },
+  gpu: {
+    usage_percent: 0,
+    temperature_celsius: 38,
+    performance_cpu_percent: 0,
+    efficiency_cpu_percent: 12,
+  },
+  energy: {
+    system_power_watts: 0,
+    monitor_session_joules: 0,
+    monitor_session_watt_hours: 0,
+    monitor_uptime_seconds: 40,
+    sampled_duration_seconds: 3,
+  },
+});
+
+test("legacy Pro zero defaults are unavailable without sensor provenance", () => {
+  const legacy = sample();
+  delete legacy.sensor_status;
+  const values = sensorValues(legacy, now);
+  assert.equal(values.state, "unavailable");
+  for (const field of [
+    "gpu",
+    "temperature",
+    "power",
+    "wattHours",
+    "sampledSeconds",
+  ])
+    assert.equal(values[field], null);
+  assert.equal(formatMetric(values.gpu, 0, "%"), "Unavailable");
+});
+
+test("real measured zero remains zero and coverage is not process uptime", () => {
+  const values = sensorValues(sample(), now);
+  assert.equal(values.state, "available");
+  assert.equal(formatMetric(values.gpu, 0, "%"), "0%");
+  assert.equal(formatMetric(values.power, 1, " W"), "0.0 W");
+  assert.equal(values.sampledSeconds, 3);
+});
+
+test("cached packets age independently of successful endpoint polling", () => {
+  assert.equal(sensorState(sample(), now + 14000), "available");
+  assert.equal(sensorState(sample(), now + 15001), "stale");
+  assert.equal(sensorValues(sample(), now + 15001).gpu, null);
+});
+
+test("invalid metadata, future timestamps, NaN, infinities and out of range values fail closed", () => {
+  for (const value of [NaN, Infinity, -1, "0", null, undefined])
+    assert.equal(finiteMetric(value), null);
+  for (const state of ["unavailable", "stale", "invalid"]) {
+    const activity = sample();
+    activity.sensor_status.state = state;
+    assert.equal(sensorValues(activity, now).power, null);
+  }
+  const invalid = sample();
+  invalid.sensor_status.sample_age_seconds = NaN;
+  assert.equal(sensorState(invalid, now), "invalid");
+  const future = sample();
+  future.sensor_status.sampled_at = new Date(now + 6000).toISOString();
+  assert.equal(sensorState(future, now), "invalid");
+  const bounds = sample();
+  bounds.gpu.usage_percent = 101;
+  bounds.energy.system_power_watts = -10;
+  assert.equal(sensorValues(bounds, now).gpu, null);
+  assert.equal(sensorValues(bounds, now).power, null);
+});
+
+test("missing energy coverage and first sensor interval are never formatted as zero", () => {
+  const first = sample();
+  first.energy.monitor_session_watt_hours = null;
+  delete first.energy.sampled_duration_seconds;
+  const values = sensorValues(first, now);
+  assert.equal(formatMetric(values.wattHours, 3, " Wh"), "Unavailable");
+  assert.equal(values.sampledSeconds, null);
+});
+
+test("cluster totals require every node and retain measured zero", () => {
+  assert.equal(completeSum([0, 0]), 0);
+  assert.equal(completeSum([15, null]), null);
+  assert.equal(completeSum([]), null);
+});
+
+test("graphs split missing intervals instead of inventing zeros or bridging gaps", () => {
+  assert.equal(
+    sparklinePath([10, null, 20, 30]),
+    "M0.0,25.4 M66.7,22.8 L100.0,20.2",
+  );
+  assert.equal(sparklinePath([null, null]), "");
+  assert.equal(sparklinePath([NaN, Infinity]), "");
+  assert.equal(sparklinePath([0, 0]), "M0.0,28.0 L100.0,28.0");
+});
+
+test("balance requires exactly two fresh measured nodes and fresh queue data", () => {
+  const row = {
+    stale: false,
+    sensorState: "available",
+    cpu: 10,
+    memoryPercent: 20,
+    gpu: 0,
+    power: 0,
+    queue: 0,
+  };
+  assert.equal(balanceScore([row, row]).score, 100);
+  for (const change of [
+    { stale: true },
+    { sensorState: "unavailable" },
+    { sensorState: "stale" },
+    { gpu: null },
+    { power: null },
+    { queue: null },
+    { cpu: NaN },
+    { gpu: 101 },
+  ]) {
+    assert.equal(balanceScore([row, { ...row, ...change }]).score, null);
+  }
+  assert.equal(balanceScore([row]).score, null);
+  assert.equal(balanceScore([row, row, row]).score, null);
+});

