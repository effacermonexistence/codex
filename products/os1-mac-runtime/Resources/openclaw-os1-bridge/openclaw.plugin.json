{
  "id": "os1-bridge",
  "name": "OS-1 Typed State Bridge",
  "description": "Read an OS-1-approved immutable run snapshot; no shell, browser, file write, backend or permission grant.",
  "categories": [
    "agent-runtimes"
  ],
  "contracts": {
    "tools": [
      "os1_state_read"
    ]
  },
  "toolMetadata": {
    "os1_state_read": {
      "optional": true
    }
  },
  "activation": {
    "onStartup": false,
    "onAgentHarnesses": [
      "openclaw"
    ],
    "onConfigPaths": [
      "plugins.entries.os1-bridge"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "adaptive_routing": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "mode"
            ],
            "properties": {
              "schema": {
                "const": 1
              },
              "mode": {
                "const": "off"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "mode",
              "policy_id",
              "version",
              "rcc_source_sha256",
              "projection_sha256",
              "reference_policy_sha256",
              "allowed_workload_classes",
              "max_nodes",
              "max_parallel",
              "max_plan_revisions",
              "max_planner_calls",
              "planner_input_bytes",
              "planner_output_tokens",
              "requires_live_reference_fallback",
              "adoption_manifest_sha256"
            ],
            "properties": {
              "schema": {
                "const": 1
              },
              "mode": {
                "const": "shadow"
              },
              "policy_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,95}$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "rcc_source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "projection_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "reference_policy_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "allowed_workload_classes": {
                "type": "array",
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,95}$"
                }
              },
              "max_nodes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "max_parallel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "max_plan_revisions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "max_planner_calls": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2
              },
              "planner_input_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 240000
              },
              "planner_output_tokens": {
                "type": "integer",
                "minimum": 256,
                "maximum": 4096
              },
              "requires_live_reference_fallback": {
                "const": true
              },
              "adoption_manifest_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "mode",
              "policy_id",
              "version",
              "rcc_source_sha256",
              "projection_sha256",
              "reference_policy_sha256",
              "allowed_workload_classes",
              "max_nodes",
              "max_parallel",
              "max_plan_revisions",
              "max_planner_calls",
              "planner_input_bytes",
              "planner_output_tokens",
              "requires_live_reference_fallback",
              "adoption_manifest_sha256"
            ],
            "properties": {
              "schema": {
                "const": 1
              },
              "mode": {
                "const": "covered_live"
              },
              "policy_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,95}$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "rcc_source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "projection_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "reference_policy_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "allowed_workload_classes": {
                "type": "array",
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,95}$"
                },
                "minItems": 1
              },
              "max_nodes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "max_parallel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "max_plan_revisions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "max_planner_calls": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2
              },
              "planner_input_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 240000
              },
              "planner_output_tokens": {
                "type": "integer",
                "minimum": 256,
                "maximum": 4096
              },
              "requires_live_reference_fallback": {
                "const": true
              },
              "adoption_manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        ]
      },
      "frozen_route_artifacts": {
        "description": "Optional host-pinned DEVELOPMENT data, SHADOW only; no calibrated or live authority.",
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "manifest_sha256",
              "manifest_bytes",
              "loader_sha256",
              "predictor_sha256"
            ],
            "properties": {
              "schema": {
                "const": 1
              },
              "manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "manifest_bytes": {
                "type": "integer",
                "minimum": 2,
                "maximum": 32768
              },
              "loader_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "predictor_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        ]
      },
      "live_plan_capability": {
        "description": "Optional private host-pinned exact original read-only admission capability; absent/invalid is inert. Not a P7 development artifact.",
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "manifest_sha256",
              "manifest_bytes",
              "loader_sha256",
              "runtime_sha256"
            ],
            "properties": {
              "schema": {
                "const": 1
              },
              "manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "manifest_bytes": {
                "type": "integer",
                "minimum": 2,
                "maximum": 16384
              },
              "loader_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "runtime_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        ]
      },
      "bounded_auto": {
        "type": "boolean",
        "description": "Host-enabled bounded execution-only local planning. Does not certify task quality or grant additional permissions."
      }
    }
  }
}
