{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "os1-private-route-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": { "binding": "WORKER_VERSION" },
  "services": [
    { "binding": "RESULT_EVALUATOR", "service": "os1-result-evaluator" },
    { "binding": "RCC_V26", "service": "os1-rcc-v26-private-v30" }
  ],
  "r2_buckets": [
    { "binding": "POLICY_BUNDLES", "bucket_name": "omar-active-vault" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROUTES", "class_name": "RouteState" },
      { "name": "ROUTE_POOLS", "class_name": "RoutePoolState" },
      { "name": "ROUTING_BUDGETS", "class_name": "RoutingBudgetState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RouteState"] },
    { "tag": "v2", "new_sqlite_classes": ["RoutingBudgetState"] },
    { "tag": "v3", "new_sqlite_classes": ["RoutePoolState"] }
  ],
  "vars": {
    "RCC_SERVICE_ID": "os1-rcc-v26-private-v30",
    "POLICY_BUNDLE_KEY": "os1/policies/86eab996aee457b10d0404ba1ef5e286716b5051f5f4e86dc340e84d4a7fea8d.json",
    "POLICY_BUNDLE_SHA256": "86eab996aee457b10d0404ba1ef5e286716b5051f5f4e86dc340e84d4a7fea8d",
    "MAX_POLICY_BUNDLE_BYTES": "65536",
    "MAX_ROUTE_STARTS_PER_HOUR": "1200",
    "ROUTING_BUDGET_EPOCH": "rcc-v5"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
