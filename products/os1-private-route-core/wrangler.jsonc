{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "os1-private-route-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "ROUTES", "class_name": "RouteState" },
      { "name": "ROUTING_BUDGETS", "class_name": "RoutingBudgetState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RouteState"] },
    { "tag": "v2", "new_sqlite_classes": ["RoutingBudgetState"] }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
