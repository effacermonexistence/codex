    {
      "source": "docs/OPERATOR.md",
      "display": true,
      "tex": "\nX_{\\rm aug}=X+\\mathcal O_\\perp[X]=(1-f_\\perp)X+f_\\perp\\mathcal K_d[X].\n"
    },
