      "source": "docs/OPERATOR.md",
      "display": true,
      "tex": "\nP_d(R)\\propto\\left(1+\\frac{R^2}{d^2}\\right)^{-3/2}.\n"
    },
    {
      "source": "docs/OPERATOR.md",
      "display": true,
      "tex": "\nR_{1/2}=\\sqrt{3}\\,d.\n"
